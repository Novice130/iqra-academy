# =============================================================================
# /opt/novicetutor/.env — runtime configuration for the production stack
# =============================================================================
# Copy to the server, fill in, then:  chmod 600 /opt/novicetutor/.env
# Never commit the filled-in file. Both containers (web, realtime) read it.
#
# Compose interpolates `$` in this file. If a value contains a literal dollar
# sign, wrap the value in single quotes.
#
# NEXT_PUBLIC_* values are NOT read from here — they are compiled into the
# image at build time (GitHub repository variables; see docs/deploy-vps.md).
# =============================================================================

# ── Database (Neon, POOLED endpoint — host contains "-pooler") ───────────────
DATABASE_URL=
DB_POOL_MAX=10

# ── Auth ─────────────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Application ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://novicetutor.com

# ── Realtime ─────────────────────────────────────────────────────────────────
# Generate a NEW one for the VPS (openssl rand -base64 32). A fallback value
# was committed to git history in the Workers era and must not be reused.
REALTIME_SECRET=

# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=

# ── LiveKit ──────────────────────────────────────────────────────────────────
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Cal.com webhooks ─────────────────────────────────────────────────────────
CALCOM_WEBHOOK_SECRET=

# ── Firebase (mobile push) ───────────────────────────────────────────────────
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# Keep the \n escapes and the double quotes.
FCM_PRIVATE_KEY=

# ── Web Push (VAPID) ─────────────────────────────────────────────────────────
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Set by docker-compose.yml, listed for reference — do not set here:
#   REALTIME_INTERNAL_URL=http://realtime:8787
#   APP_INTERNAL_URL=http://web:3000
#   REALTIME_PORT=8787
#   APP_DOWNLOADS_DIR=/data/downloads
