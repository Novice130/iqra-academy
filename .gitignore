# Environment & sensitive credential files
.env*
!.env.example
*.exp
.iqra-ssh.exp
.rsync.exp
*.pem
*.key
# App Store Connect API keys — anyone holding one can ship builds as us.
*.p8
# Signed app builds. Same rule as the APK: never in git.
*.ipa
.wrangler/
.cloudflared/

# Generated files & logs
node_modules/
.next/
.turbo/
build/
.cache/
*.log
dist/
coverage/

.open-next/
**.open-next/
*.txt
*.ps1
*.json.tmp
repos*.json
repo_files.json
.commandcode/

# Machine-generated, and previously committed by accident: 22MB of turbo
# cache, the graphify code-graph output, and TypeScript's incremental cache.
# All of it regenerates; none of it belongs in history.
.turbo/
**/.turbo/
.graphify/
**/.graphify/
*.tsbuildinfo
.DS_Store
**/.DS_Store

**/node_modules/
**/.next/
**/build/
**/.dart_tool/
**/.flutter-plugins*
**/.packages
**/.pub-cache

# design-sync (claude.ai/design) — staged scripts, build output, machine state
.ds-sync/
ds-bundle/
apps/web/.ds-css/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
