{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "novicetutor",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  // The Android APKs. They cannot live in `assets/` — a single static asset
  // is capped at 25 MiB and the arm64 build passed that the moment screen
  // sharing added WebRTC's native libraries. They are streamed out of R2 by
  // /api/app-download/[file] instead, so the download URLs stay on the app's
  // own domain and the bucket stays private.
  "r2_buckets": [
    {
      "binding": "APP_DOWNLOADS",
      "bucket_name": "novicetutor-app"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "AVAILABILITY_HUB",
        "class_name": "AvailabilityHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AvailabilityHub"]
    }
  ],
  // Outbox retry sweeper. Per-request afterResponse drains cover the happy
  // path, but a failed publish must not wait for the next unrelated mutation:
  // this cron hits the service-authed drain route every minute, which retries
  // unpublished rows (attempts < 5) and dead-letters the rest. The route
  // returns { published, failed, deadLettered } for the alert in Phase 11
  // monitoring; REALTIME_SECRET must be set as a worker secret/var.
  "triggers": {
    "crons": ["*/1 * * * *"]
  },
  // Workers Logs. Without this an "exceeded resource limits" (1102) burst
  // leaves nothing behind but request counts in analytics — the August 6/7
  // outages had to be traced by guessing at paths. Sampling stays at 1 so a
  // burst that lasts four minutes is fully captured.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "routes": [
    { "pattern": "novicetutor.com", "custom_domain": true },
    { "pattern": "www.novicetutor.com", "custom_domain": true }
  ]
}
