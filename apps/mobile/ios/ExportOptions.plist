<?xml version="1.0" encoding="UTF-8"?>
<!--
  How `flutter build ipa` is told to sign and package for the App Store.

  Without this file the build stops halfway and prints instructions, which is
  fine once and useless in a script. Everything here is public: the team id is
  already in project.pbxproj, and no key, password or profile lives in this
  file — see docs/ios-release.md for where those go.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- app-store-connect covers TestFlight and the App Store both: they are
	     the same upload, and which testers see it is decided afterwards in
	     App Store Connect, not at build time. -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>teamID</key>
	<string>TT3HQ774N4</string>
	<!-- Xcode manages the distribution certificate and provisioning profile.
	     Manual signing means a profile file that expires in a year and has to
	     be regenerated by hand on a machine that is also the only one that can
	     build — the wrong trade for a one-person shop. -->
	<key>signingStyle</key>
	<string>automatic</string>
	<!-- Xcode must NOT rewrite the version and build number. The script sets
	     both from pubspec.yaml and the git history, and having two things
	     choose it is how a build gets rejected for reusing a number. -->
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
	<!-- dSYMs go up with the build, so a crash report from TestFlight arrives
	     symbolicated instead of as hex addresses. -->
	<key>uploadSymbols</key>
	<true/>
	<!-- Bitcode has been dead since Xcode 14; saying so keeps the warning out
	     of the log. -->
	<key>compileBitcode</key>
	<false/>
	<key>destination</key>
	<string>export</string>
	<key>stripSwiftSymbols</key>
	<true/>
</dict>
</plist>
