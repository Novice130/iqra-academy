{
  "name": "desktop",
  "productName": "Novice Tutor",
  "version": "1.0.0",
  "description": "Novice Tutor for Windows",
  "private": true,
  "main": "dist/main/index.js",
  "author": "Novice Tutor",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "npm run build && electron .",
    "dev": "npm run build && cross-env NT_APP_URL=http://localhost:3005 electron .",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:dir": "npm run build && electron-builder --dir --publish never",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "cross-env": "^10.1.0",
    "electron": "43.3.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5"
  }
}
